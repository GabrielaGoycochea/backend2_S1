{
  "info": {
    "_postman_id": "d3edef67-8657-4a9e-aba8-4556929644a5",
    "name": "PETSALUD - Semana 3 - Amenazas comunes",
    "description": "Pruebas de la Semana 3: SQL Injection, XSS, CSRF, @PreAuthorize y monitoreo. Requiere la API con el perfil prueba. Cada solicitud trae una prueba (pestaña Tests) con el código esperado, así que se puede ejecutar con el Collection Runner. Los eventos de seguridad quedan en la consola y en logs/petsalud.log. No compartir credenciales ni tokens reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Preparación (logins por rol)",
      "description": "Configurar la variable clavePrueba con la clave del perfil prueba (ver README) y ejecutar estas 3 solicitudes primero.",
      "item": [
        {
          "name": "Login CLIENTE",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario del perfil prueba. Guarda el JWT en la variable tokenCliente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@petsalud.cl\",\n  \"password\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login VETERINARIO",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario del perfil prueba. Guarda el JWT en la variable tokenVet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vet@petsalud.cl\",\n  \"password\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenVet\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario del perfil prueba. Guarda el JWT en la variable tokenAdmin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@petsalud.cl\",\n  \"password\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - SQL Injection",
      "item": [
        {
          "name": "SQLi en el login (credenciales)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "La carga se envía como un valor (parámetro enlazado por JPA): no encuentra usuario. En el log queda LOGIN_FALLIDO con la IP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"' OR '1'='1' --\",\n  \"password\": \"' OR '1'='1' --\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SQLi en el email del registro",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "registro"
              ]
            },
            "description": "La validación @Email del DTO rechaza el dato antes de llegar a la base. En el log queda ENTRADA_RECHAZADA campos=email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@petsalud.cl' OR '1'='1\",\n  \"password\": \"Clave1234\",\n  \"nombre\": \"Ana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SQLi en la búsqueda por categoría",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/categoria?categoria=Alimentos' OR '1'='1' --",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "categoria"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Alimentos' OR '1'='1' --"
                }
              ]
            },
            "description": "@Pattern rechaza comillas y signo igual en el parámetro."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SQLi en el id de la ruta",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mascotas/1 OR 1=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mascotas",
                "1 OR 1=1"
              ]
            },
            "description": "El id debe ser numérico: responde 400 (campos=id) sin consultar la base."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - XSS",
      "item": [
        {
          "name": "Script en el nombre de la mascota (CLIENTE)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mascotas/propietario/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mascotas",
                "propietario",
                "1"
              ]
            },
            "description": "El DTO no acepta < ni >. En el log queda ENTRADA_RECHAZADA campos=nombre (sin el script).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"<script>alert('xss')</script>\",\n  \"especie\": \"Perro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "HTML en el diagnóstico (VETERINARIO)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expedientes?mascotaId=1&veterinarioId=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "expedientes"
              ],
              "query": [
                {
                  "key": "mascotaId",
                  "value": "1"
                },
                {
                  "key": "veterinarioId",
                  "value": "2"
                }
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Control anual\",\n  \"diagnostico\": \"<img src=x onerror=alert(1)>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Script en el motivo de la cita (CLIENTE)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citas?mascotaId=1&veterinarioId=2&fechaHora=2026-12-01T10:00:00&motivo=<script>alert(1)</script>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ],
              "query": [
                {
                  "key": "mascotaId",
                  "value": "1"
                },
                {
                  "key": "veterinarioId",
                  "value": "2"
                },
                {
                  "key": "fechaHora",
                  "value": "2026-12-01T10:00:00"
                },
                {
                  "key": "motivo",
                  "value": "<script>alert(1)</script>"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cabeceras de seguridad en la respuesta",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Revisar la pestaña Headers: Content-Security-Policy, X-Content-Type-Options: nosniff y X-Frame-Options: DENY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Trae Content-Security-Policy\", function () { pm.response.to.have.header(\"Content-Security-Policy\"); });",
                  "pm.test(\"Trae X-Content-Type-Options\", function () { pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - CSRF",
      "item": [
        {
          "name": "Cookie de sesión sin Bearer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID=sesion-robada"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Simula lo que haría el navegador en un ataque CSRF: adjunta una cookie, pero la API solo acepta el JWT en el header Authorization.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alimento perro 15 kg\",\n  \"precio\": 24990,\n  \"stock\": 20,\n  \"categoria\": \"Alimentos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login no entrega cookie de sesión",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Revisar la pestaña Headers: no hay Set-Cookie. La API es stateless.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@petsalud.cl\",\n  \"password\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Sin Set-Cookie\", function () { pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Preflight desde un sitio no autorizado",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://sitio-malicioso.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "CORS solo permite los front de cors.allowed-origins: el navegador bloquearía la llamada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Preflight desde el front autorizado",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Roles con @PreAuthorize",
      "item": [
        {
          "name": "CLIENTE envía notificación",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/usuario/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notificaciones",
                "usuario",
                "1"
              ]
            },
            "description": "La regla por URL solo exige autenticación: lo bloquea @PreAuthorize(GERENTE). Log: ACCESO_DENEGADO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensaje\": \"Campaña de vacunación\",\n  \"tipo\": \"Promoción\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "VETERINARIO elimina expediente",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/expedientes/{{expedienteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "expedientes",
                "{{expedienteId}}"
              ]
            },
            "description": "Eliminar historial clínico queda solo para el gerente."
          },
          "event": [
            {
              "listen": "test",
