  "item": [
    {
      "name": "00 - Autenticación JWT",
      "item": [
        {
          "name": "01 - Login JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const r = pm.response.json();",
                  "    const token = r.token || r.accessToken || r.jwt || r.jwtToken;",
                  "    if (typeof token === \"string\" && token.length) {",
                  "      pm.collectionVariables.set(\"jwtToken\", token);",
                  "      console.log(\"JWT guardado en jwtToken.\");",
                  "    } else {",
                  "      console.warn(\"No se detectó un campo de token conocido. Revisa la respuesta.\");",
                  "    }",
                  "  } catch (e) { console.warn(\"La respuesta no es JSON.\"); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoPrueba}}\",\n  \"password\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Se requiere una cuenta existente y válida. No guardar/exportar contraseñas ni tokens reales."
          },
          "response": []
        },
