        },
        {
          "name": "Figura 18 - JWT firma alterada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const original = pm.collectionVariables.get(\"jwtToken\");\r\n\r\nif (!original || original.split(\".\").length !== 3) {\r\n    throw new Error(\"No se encontró un JWT válido. Inicia sesión primero.\");\r\n}\r\n\r\nconst partes = original.split(\".\");\r\n\r\n// Cambiar solamente el primer carácter de la firma.\r\nconst firma = partes[2];\r\n\r\npartes[2] = (firma[0] === \"A\" ? \"B\" : \"A\")\r\n    + firma.slice(1);\r\n\r\n// Guardar el JWT alterado sin modificar el original.\r\npm.collectionVariables.set(\r\n    \"jwtTokenAlterado\",\r\n    partes.join(\".\")\r\n);\r\n\r\nconsole.log(\"JWT con firma alterada preparado.\");"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtTokenAlterado}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Figura 19 - JWT vencido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const guardado = pm.collectionVariables.get(\"jwtTokenFijo19\");\r\n\r\nif (!guardado) {\r\n    const original = pm.collectionVariables.get(\"jwtToken\");\r\n\r\n    if (!original || original.split(\".\").length !== 3) {\r\n        throw new Error(\"Primero debes iniciar sesión y obtener un JWT válido.\");\r\n    }\r\n\r\n    pm.collectionVariables.set(\"jwtTokenFijo19\", original);\r\n    console.log(\"JWT original guardado para comprobar su vencimiento.\");\r\n} else {\r\n    console.log(\"Se conserva el mismo JWT para verificar su expiración.\");\r\n}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.collectionVariables.get(\"jwtTokenFijo19\");\r\n\r\npm.test(\"Existe un JWT para comprobar\", function () {\r\n    pm.expect(token).to.be.a(\"string\");\r\n    pm.expect(token.split(\".\")).to.have.lengthOf(3);\r\n});\r\n\r\nif (token && token.split(\".\").length === 3) {\r\n    const base64 = token.split(\".\")[1]\r\n        .replace(/-/g, \"+\")\r\n        .replace(/_/g, \"/\");\r\n\r\n    const payload = JSON.parse(\r\n        atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, \"=\"))\r\n    );\r\n\r\n    const duracion = payload.exp - payload.iat;\r\n    const vencido = Date.now() >= payload.exp * 1000;\r\n\r\n    console.log(\"Emisión:\", new Date(payload.iat * 1000).toISOString());\r\n    console.log(\"Vencimiento:\", new Date(payload.exp * 1000).toISOString());\r\n    console.log(\"Duración:\", duracion, \"segundos\");\r\n    console.log(\"Token vencido:\", vencido);\r\n\r\n    pm.test(\"JWT configurado para durar 60 segundos\", function () {\r\n        pm.expect(duracion).to.eql(60);\r\n    });\r\n\r\n    pm.test(\"Respuesta correcta según la vigencia del JWT\", function () {\r\n        pm.response.to.have.status(vencido ? 401 : 200);\r\n    });\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtTokenFijo19}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          },
          "response": []
        }
      ]
