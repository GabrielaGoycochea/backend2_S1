            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/usuario/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notificaciones",
                "usuario",
                "{{usuarioId}}"
              ]
            },
            "description": "usuarioId debe existir (por ejemplo, el id de cliente@petsalud.cl). Log: OPERACION usuario=admin@petsalud.cl.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensaje\": \"Campaña de vacunación\",\n  \"tipo\": \"Promoción\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Monitoreo",
      "item": [
        {
          "name": "JWT con la firma alterada",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlterado}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/stock-bajo?cantidad=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "stock-bajo"
              ],
              "query": [
